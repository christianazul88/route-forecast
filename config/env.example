; On XAMPP copy to C:\xampp\route-forecast.env (outside htdocs).
; On a Linux host without access outside its web root, copy to config/.env.
; The config/.htaccess file must block direct web access to that file.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=route_forecast
DB_USER=root
DB_PASS=
; Obtain a free OpenRouteService key and place it here for Route Forecast.
ORS_API_KEY=
; For hosted first-admin setup only. Set a random 20+ character value, then open public/setup.php.
SETUP_TOKEN=
